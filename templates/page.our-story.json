    "our_story_beginning_tGUMAH": {
      "type": "our-story-beginning",
      "blocks": {
        "paragraph_xUBXDT": {
          "type": "paragraph",
          "settings": {
            "text": "<p>On a monsoon visit to Darbhanga, our founder watched farmers wade chest-deep to hand-harvest fox nuts — a crop that has fed this region for centuries, sold onward for pennies and rarely credited.</p>"
          }
        },
        "paragraph_7jMXnJ": {
          "type": "paragraph",
          "settings": {
            "text": "<p>The makhana that came home from that trip, simply roasted in a clay pan, was better than anything on a supermarket shelf. The question wrote itself: <em>why does the honest version never make it to the city?</em></p>"
          }
        },
        "paragraph_dL6rpA": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Wardham is our answer — a direct line from those ponds to your pantry, with the farmers paid fairly and the makhana treated with the care it always deserved.</p>"
          }
        }
      },
      "block_order": [
