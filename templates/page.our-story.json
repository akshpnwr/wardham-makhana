    "faq_3xRYLi": {
      "type": "faq",
      "blocks": {
        "question_D7nMq9": {
          "type": "question",
          "settings": {
            "question": "What exactly is makhana?",
            "answer": "<p>Makhana — also called fox nuts or lotus seeds — are the popped seeds of the water lily, grown in the wetland ponds of Bihar. Naturally high in protein and low in fat, they have been an everyday snack across India for centuries.</p>"
          }
        },
        "question_Erm8W7": {
          "type": "question",
          "settings": {
            "question": "Are Wardham makhana roasted or fried?",
            "answer": "<p>Always roasted, never fried. We slow-roast in small batches with a touch of cold-pressed oil, which keeps the crunch light and preserves the natural nutrition.</p>"
          }
        },
        "question_TREiMn": {
          "type": "question",
          "settings": {
            "question": "What is in each pack besides makhana?",
            "answer": "<p>Only real ingredients you can pronounce — sea salt, single-origin spices, and cold-pressed oils. No preservatives, no palm oil, no artificial colours or flavour enhancers.</p>"
          }
        },
        "question_dre8tz": {
          "type": "question",
          "settings": {
            "question": "Where do you source your makhana?",
            "answer": "<p>Directly from 200+ farming families across Bihar’s Mithila belt, at prices agreed before the season. No middlemen, no auction floors — so the growers are the ones who gain.</p>"
          }
        },
        "question_DYNepf": {
          "type": "question",
          "settings": {
            "question": "How should I store an opened pack?",
            "answer": "<p>Reseal the pouch or move the makhana to an airtight jar and keep it somewhere cool and dry. Best enjoyed within two weeks of opening for peak crunch.</p>"
          }
        },
        "question_V4Pw7k": {
          "type": "question",
          "settings": {
            "question": "Do you ship across India?",
            "answer": "<p>Yes — we ship pan-India, with free delivery on orders above ₹599. Most orders arrive within 3–5 working days.</p>"
          }
        }
      },
