<div
  class="wardham-ingredient color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding isolate"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="wardham-ingredient__layout {% if section.settings.media_position == 'right' %}wardham-ingredient__layout--reverse{% endif %}">

      {%- comment -%} LEFT COLUMN — collage built from blocks {%- endcomment -%}
      <div class="wardham-ingredient__collage">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'image' -%}
              <div class="wardham-ingredient__cell wardham-ingredient__cell--image" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 40vw, 90vw',
                      widths: '400, 600, 800, 1000, 1200',
                      class: 'wardham-ingredient__img'
                  }}
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'wardham-ingredient__img wardham-ingredient__placeholder' }}
                {%- endif -%}
              </div>
            {%- when 'text' -%}
              <div class="wardham-ingredient__cell wardham-ingredient__cell--text color-{{ block.settings.tile_color_scheme }} gradient" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  <p class="wardham-ingredient__tiletext">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%} RIGHT COLUMN — editorial copy {%- endcomment -%}
      <div class="wardham-ingredient__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="wardham-ingredient__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wardham-ingredient__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="wardham-ingredient__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link_url | default: '#' }}" class="wardham-ingredient__link">
            {{ section.settings.link_label }} &rarr;
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .wardham-ingredient {
    padding-top: var(--pt, 140px);
    padding-bottom: var(--pb, 140px);
  }

  .wardham-ingredient__layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .wardham-ingredient__layout--reverse {
    direction: rtl;
  }
  .wardham-ingredient__layout--reverse > * {
    direction: ltr;
  }

  /* Collage: large image left (full height), 2nd cell top-right, 3rd cell bottom-right */
  .wardham-ingredient__collage {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2rem;
    height: 64rem;
  }
  .wardham-ingredient__cell {
    overflow: hidden;
  }
  .wardham-ingredient__cell:first-child {
    grid-row: 1 / span 2;
  }

  .wardham-ingredient__img,
  .wardham-ingredient__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wardham-ingredient__cell--text {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.4rem;
  }
  .wardham-ingredient__tiletext {
    margin: 0;
    font-family: var(--font-heading-family), serif;
    font-style: italic;
    font-size: 2.2rem;
    line-height: 1.4;
    text-align: center;
  }

  .wardham-ingredient__content {
    padding: 4rem;
  }
  .wardham-ingredient__eyebrow {
    font-size: 14px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin: 0 0 1.2rem;
    color: #0F5132;
  }
  .wardham-ingredient__heading {
    margin: 0 0 3.2rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .wardham-ingredient__body {
    font-size: 1.6rem;
    line-height: 1.7;
    max-width: 42rem;
    margin: 0 0 3.2rem;
    opacity: 0.9;
    color: #7a7a76;
  }
  .wardham-ingredient__link {
    font-size: 1.3rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: currentColor;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.4rem;
  }

  @media (max-width: 990px) {
    .wardham-ingredient__layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .wardham-ingredient__collage { height: 48rem; }
    .wardham-ingredient__content { padding: 0; }
  }
  @media (max-width: 640px) {
    .wardham-ingredient__collage { height: 40rem; gap: 1.4rem; }
    .wardham-ingredient__tiletext { font-size: 1.8rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wardham Ingredient",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content (right column)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "— The Ingredient"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Simple ingredients. Nothing artificial. Everything delicious."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Our fox nuts are hand-picked from the wetlands of Bihar, sun-dried, then slow-roasted in tiny batches with cold-pressed oils and single-origin spices.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read our sourcing story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Collage position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 140
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "paragraph",
          "content": "The first block becomes the large image. Following blocks stack in the right of the collage."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text tile",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Tile text",
          "default": "From pond to pantry."
        },
        {
          "type": "color_scheme",
          "id": "tile_color_scheme",
          "label": "Tile color scheme",
          "default": "scheme-7"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Ingredient",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
