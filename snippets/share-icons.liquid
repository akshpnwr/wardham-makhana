{%- doc -%}
  Row of share links (Facebook, X, Pinterest, Telegram, WhatsApp, email) for the current product.
  Icons: Phosphor Icons (fill), MIT licence, https://phosphoricons.com

  @param {object} product - The product being shared.
  @param {object} [block] - The block, for theme editor attributes.

  @example
  {% render 'share-icons', product: product, block: block %}
{%- enddoc -%}
{%- liquid
  assign url = product.selected_variant.url | default: product.url | prepend: request.origin | url_encode
  assign title = product.title | url_encode
  assign image = product.featured_media | image_url: width: 1200 | prepend: 'https:' | url_encode
-%}
<ul class="share-icons list-unstyled" role="list" {{ block.shopify_attributes }}>
  <li>
    <a class="share-icons__link" href="https://www.facebook.com/sharer/sharer.php?u={{ url }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" class="icon share-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M232,128a104.16,104.16,0,0,1-91.55,103.26,4,4,0,0,1-4.45-4V152h24a8,8,0,0,0,8-8.53,8.17,8.17,0,0,0-8.25-7.47H136V112a16,16,0,0,1,16-16h16a8,8,0,0,0,8-8.53A8.17,8.17,0,0,0,167.73,80H152a32,32,0,0,0-32,32v24H96a8,8,0,0,0-8,8.53A8.17,8.17,0,0,0,96.27,152H120v75.28a4,4,0,0,1-4.44,4A104.15,104.15,0,0,1,24.07,124.09c2-54,45.74-97.9,99.78-100A104.12,104.12,0,0,1,232,128Z"/></svg>
      <span class="visually-hidden">Share on Facebook</span>
    </a>
  </li>
  <li>
    <a class="share-icons__link" href="https://x.com/intent/post?url={{ url }}&text={{ title }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" class="icon share-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M215,219.85a8,8,0,0,1-7,4.15H160a8,8,0,0,1-6.75-3.71l-40.49-63.63L53.92,221.38a8,8,0,0,1-11.84-10.76l61.77-68L41.25,44.3A8,8,0,0,1,48,32H96a8,8,0,0,1,6.75,3.71l40.49,63.63,58.84-64.72a8,8,0,0,1,11.84,10.76l-61.77,67.95,62.6,98.38A8,8,0,0,1,215,219.85Z"/></svg>
      <span class="visually-hidden">Share on X</span>
    </a>
  </li>
  <li>
    <a class="share-icons__link" href="https://pinterest.com/pin/create/button/?url={{ url }}&media={{ image }}&description={{ title }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" class="icon share-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M240,128.7c-.38,56.49-46.46,102.73-102.94,103.29a104.16,104.16,0,0,1-25.94-3,4,4,0,0,1-2.91-4.86l8.64-34.55A60.57,60.57,0,0,0,144,196c37,0,66.7-33.45,63.81-73.36A72,72,0,1,0,69.24,155,8,8,0,0,0,80,159.29a8.19,8.19,0,0,0,4-10.49,56,56,0,1,1,107.86-24.93C194,154.4,171.73,180,144,180a44.87,44.87,0,0,1-23.14-6.44l14.9-59.62a8,8,0,0,0-15.52-3.88L93.38,217.51a4,4,0,0,1-5.71,2.59A104,104,0,0,1,32,126.88C32.6,70.52,78.67,24.52,135,24A104,104,0,0,1,240,128.7Z"/></svg>
      <span class="visually-hidden">Share on Pinterest</span>
    </a>
  </li>
  <li>
    <a class="share-icons__link" href="https://t.me/share/url?url={{ url }}&text={{ title }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" class="icon share-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M228.88,26.19a9,9,0,0,0-9.16-1.57L17.06,103.93a14.22,14.22,0,0,0,2.43,27.21L72,141.45V200a15.92,15.92,0,0,0,10,14.83,15.91,15.91,0,0,0,17.51-3.73l25.32-26.26L165,220a15.88,15.88,0,0,0,10.51,4,16.3,16.3,0,0,0,5-.79,15.85,15.85,0,0,0,10.67-11.63L231.77,35A9,9,0,0,0,228.88,26.19ZM175.53,208,92.85,135.5l119-85.29Z"/></svg>
      <span class="visually-hidden">Share on Telegram</span>
    </a>
  </li>
  <li>
    <a class="share-icons__link" href="https://wa.me/?text={{ title }}%20{{ url }}" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false" class="icon share-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M152.58,145.23l23,11.48A24,24,0,0,1,152,176a72.08,72.08,0,0,1-72-72A24,24,0,0,1,99.29,80.46l11.48,23L101,118a8,8,0,0,0-.73,7.51,56.47,56.47,0,0,0,30.15,30.15A8,8,0,0,0,138,155ZM232,128A104,104,0,0,1,79.12,219.82L45.07,231.17a16,16,0,0,1-20.24-20.24l11.35-34.05A104,104,0,1,1,232,128Zm-40,24a8,8,0,0,0-4.42-7.16l-32-16a8,8,0,0,0-8,.5l-14.69,9.8a40.55,40.55,0,0,1-16-16l9.8-14.69a8,8,0,0,0,.5-8l-16-32A8,8,0,0,0,104,64a40,40,0,0,0-40,40,88.1,88.1,0,0,0,88,88A40,40,0,0,0,192,152Z"/></svg>
      <span class="visually-hidden">Share on WhatsApp</span>
    </a>
  </li>
  <li>
    <a class="share-icons__link" href="mailto:?subject={{ title }}&body={{ url }}">
      <svg aria-hidden="true" focusable="false" class="icon share-icons__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-8,144H40V74.19l82.59,75.71a8,8,0,0,0,10.82,0L216,74.19V192Z"/></svg>
      <span class="visually-hidden">Share by email</span>
    </a>
  </li>
</ul>
